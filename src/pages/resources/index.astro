---
import Layout from '../../layouts/Layout.astro';
import cloudDownloadIcon from '../../assets/icons/cloud-download.svg';
---
<Layout title="Resources - GDGoC">
  <main>
    <div class="container mx-auto px-4 py-8">
      <h1 class="text-4xl font-bold text-center mb-8">Resources</h1>
      <div class="max-w-3xl mx-auto">
        <p class="text-lg text-gray-700 mb-6 text-center">
          Download helpful guides, notes, and reference materials for your tech journey. More resources coming soon!
        </p>
      
        <div class="mt-10">
          <h2 class="text-2xl font-bold mb-4 text-center">Online Learning Platforms</h2>
          <ul class="grid gap-4 md:grid-cols-3">
            <li>
              <a href="https://www.w3schools.com/" target="_blank" rel="noopener" class="block bg-white rounded-xl shadow p-4 text-center hover:bg-blue-50 transition">
                <span class="font-semibold text-lg text-blue-700">W3Schools</span>
                <p class="text-gray-600 text-sm mt-2">Comprehensive tutorials and references for web development technologies.</p>
              </a>
            </li>
            <li>
              <a href="https://www.tutorialspoint.com/" target="_blank" rel="noopener" class="block bg-white rounded-xl shadow p-4 text-center hover:bg-blue-50 transition">
                <span class="font-semibold text-lg text-green-700">Tutorialspoint</span>
                <p class="text-gray-600 text-sm mt-2">Wide range of tutorials and resources for programming, engineering, and more.</p>
              </a>
            </li>
            <li>
              <a href="https://www.freecodecamp.org/" target="_blank" rel="noopener" class="block bg-white rounded-xl shadow p-4 text-center hover:bg-blue-50 transition">
                <span class="font-semibold text-lg text-gray-800">freeCodeCamp</span>
                <p class="text-gray-600 text-sm mt-2">Free coding lessons, projects, and certifications for web development and more.</p>
              </a>
            </li>
            <li>
              <a href="https://www.theodinproject.com/paths/" target="_blank" rel="noopener" class="block bg-white rounded-xl shadow p-4 text-center hover:bg-blue-50 transition">
                <span class="font-semibold text-lg text-yellow-700">The Odin Project</span>
                <p class="text-gray-600 text-sm mt-2">Open-source full-stack curriculum for learning web development from scratch.</p>
              </a>
            </li>
            <li>
              <a href="https://quickref.me/" target="_blank" rel="noopener" class="block bg-white rounded-xl shadow p-4 text-center hover:bg-blue-50 transition">
                <span class="font-semibold text-lg text-purple-700">quickref.me</span>
                <p class="text-gray-600 text-sm mt-2">Handy reference cheat sheets for programming languages, frameworks, and tools.</p>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </main>
</Layout>